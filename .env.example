# Django Backend Configuration
DJANGO_SECRET_KEY=your-production-secret-key-must-be-random
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Database Configuration (PostgreSQL in Production, SQLite fallback in local development)
DATABASE_URL=postgresql://postgres:password@localhost:5432/south_india_job_agent

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Scheduling
DISCOVERY_CRON_HOUR=6

# LLM Provider Configuration (Optional - agent uses deterministic rule engine when keys omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email Digests (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:8000
